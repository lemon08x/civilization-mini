{
  "name": "civilization-mini-rules-lab",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "description": "普通人跨代生活的桌游式规则预研；确定性模拟器与 AI 行动接口",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build-manifest.mjs",
    "start": "npm run build && node dist/apps/board/server.js",
    "lab": "node dist/apps/cli/main.js",
    "simulate": "node dist/apps/cli/main.js simulate",
    "research:audit": "node scripts/research-audit.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.8.3"
  }
}
